{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Ceratops-Code/AI-Agent-Skills/schemas/release.yml.schema.json",
  "title": "Ceratops repository release-publication contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "operations"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "kind": {
      "const": "ceratops-release"
    },
    "artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "operations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_type",
        "registry",
        "package_or_image_name",
        "version_source",
        "release_policy",
        "tag_style",
        "changelog_source",
        "post_publish_consumer_check"
      ],
      "properties": {
        "artifact_type": {
          "description": "Artifact type declared by the lifecycle artifact type system.",
          "type": "string",
          "minLength": 1
        },
        "registry": {
          "description": "Registry host or lifecycle target such as github_release or pages.",
          "type": "string",
          "minLength": 1
        },
        "package_or_image_name": {
          "description": "External package, image, release asset, module, chart, or site name.",
          "type": "string",
          "minLength": 1
        },
        "version_source": {
          "description": "Manifest, Git tag, release tag, package metadata, or another explicitly approved version source.",
          "type": "string",
          "minLength": 1
        },
        "release_policy": {
          "description": "Publication policy such as manual, tag-driven, workflow-driven, no-artifact, or another explicitly approved value.",
          "type": "string",
          "minLength": 1
        },
        "tag_style": {
          "description": "Tag format such as semver, v-prefix-semver, calendar, SHA, digest, or another explicitly approved value.",
          "type": "string",
          "minLength": 1
        },
        "changelog_source": {
          "description": "CHANGELOG.md, GitHub release notes, package metadata, or another explicitly approved changelog source.",
          "type": "string",
          "minLength": 1
        },
        "post_publish_consumer_check": {
          "description": "Command or endpoint used to verify consumers can fetch and use the published artifact.",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "parameters": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "run"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
